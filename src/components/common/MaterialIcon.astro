---
interface Props {
  name: string;
  className?: string;
  size?: number | string;
  filled?: boolean;
}

const {
  name,
  className = '',
  size = 20,
  filled = true,
} = Astro.props;

const sizeClass = typeof size === 'number' ? `text-[${size}px]` : '';
const styleAttr = typeof size === 'number' ? `font-size: ${size}px; line-height: 1;` : '';
---

<span
  class={`material-symbols-outlined select-none inline-block align-middle ${filled ? 'font-fill' : ''} ${sizeClass} ${className}`}
  style={styleAttr}
  aria-hidden="true"
>{name}</span>
