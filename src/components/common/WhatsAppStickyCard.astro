---
import MaterialIcon from './MaterialIcon.astro';

interface Props {
  title?: string;
  subtitle?: string;
  ctaText?: string;
  message?: string;
}

const {
  title = 'Butuh Konsultasi Cepat?',
  subtitle = 'Chat admin WhatsApp sekarang. Gratis tanya teknis, survey, dan penjadwalan tanpa DP.',
  ctaText = 'Chat Admin WhatsApp',
  message = 'Halo Admin CCTV Palembang (cctvpalembang.web.id). Saya ingin konsultasi pemasangan CCTV di wilayah saya...',
} = Astro.props;

const waNumber = '6285758903353';
const waLink = `https://wa.me/${waNumber}?text=${encodeURIComponent(message)}`;
---

<aside class="bg-gradient-to-br from-security-card to-slate-900 border border-brand-500/40 rounded-2xl p-6 shadow-xl">
  <div class="flex items-center gap-3 mb-4">
    <div class="w-10 h-10 rounded-full bg-emerald-500/15 border border-emerald-500/30 flex items-center justify-center shrink-0">
      <MaterialIcon name="support_agent" className="text-emerald-400" size={24} />
    </div>
    <div>
      <p class="text-xs font-semibold text-emerald-400 uppercase tracking-wider">Hotline Resmi</p>
      <p class="text-base font-bold text-white">0857-5890-3353</p>
    </div>
  </div>

  <h3 class="text-lg font-bold text-white mb-2 leading-snug">{title}</h3>
  <p class="text-sm text-slate-300 mb-5 leading-relaxed">{subtitle}</p>

  <a href={waLink} target="_blank" rel="noopener nofollow" class="flex items-center justify-center gap-2 w-full text-center bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm py-3 px-4 rounded-xl transition-all shadow-lg shadow-emerald-900/40 hover:-translate-y-0.5">
    <MaterialIcon name="chat" size={18} />
    <span>{ctaText}</span>
  </a>

  <div class="mt-4 pt-4 border-t border-slate-700/60 text-xs text-slate-400 space-y-2">
    <p class="flex items-center gap-2"><MaterialIcon name="check_circle" className="text-emerald-400 shrink-0" size={16} /> 100% Tanpa DP (Bayar Setelah Terpasang)</p>
    <p class="flex items-center gap-2"><MaterialIcon name="verified_user" className="text-emerald-400 shrink-0" size={16} /> Garansi Resmi 1 Tahun Ganti Baru</p>
    <p class="flex items-center gap-2"><MaterialIcon name="engineering" className="text-emerald-400 shrink-0" size={16} /> Teknisi SOP Rapi &amp; Bebas Asap Rokok</p>
  </div>
</aside>
