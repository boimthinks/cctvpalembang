---
import MaterialIcon from '../common/MaterialIcon.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Beranda' },
  { href: '/paket/', label: 'Paket CCTV' },
];

const serviceDropdown = [
  {
    href: '/layanan/pasang-cctv-rumah-palembang/',
    label: 'CCTV Rumah & Cluster',
    icon: 'home',
    desc: 'Instalasi rumah hunian, garasi, dan perumahan cluster.',
  },
  {
    href: '/layanan/pasang-cctv-ruko-toko-palembang/',
    label: 'CCTV Ruko & Toko',
    icon: 'storefront',
    desc: 'Pengawasan kasir, etalase, dan anti maling ruko.',
  },
  {
    href: '/layanan/instalasi-ip-camera-gedung-pabrik-palembang/',
    label: 'IP Camera Gedung & Pabrik',
    icon: 'domain',
    desc: 'Sistem PoE resolusi tinggi untuk industri dan gudang.',
  },
  {
    href: '/layanan/jasa-servis-maintenance-cctv-palembang/',
    label: 'Servis & Maintenance',
    icon: 'build',
    desc: 'Perbaikan kamera mati, DVR error, dan setting HP.',
  },
  {
    href: '/layanan/paket-cctv-palembang-murah/',
    label: 'Paket CCTV Murah',
    icon: 'inventory_2',
    desc: 'Paket 2, 4, 8 kamera Hikvision & Dahua terima beres.',
  },
];

const navLinksAfter = [
  { href: '/layanan/jasa-servis-maintenance-cctv-palembang/', label: 'Service CCTV' },
  { href: '/blog/', label: 'Blog' },
  { href: '/tentang-kami/', label: 'Tentang Kami' },
];

const isServiceActive = currentPath.startsWith('/layanan/');

const waLink = 'https://wa.me/6285101718690?text=Halo%20Admin%20CCTV%20Palembang%20(cctvpalembang.web.id).%20Saya%20tertarik%20tanya%20pemasangan%20CCTV...';
---

<!-- Top Bar Promo -->
<div class="bg-gradient-to-r from-brand-900 via-brand-800 to-security-dark text-xs text-brand-100 py-1.5 px-4 border-b border-brand-700/30">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <div class="flex items-center gap-2 truncate">
      <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-accent-500 text-slate-900 uppercase">Promo 2026</span>
      <span class="truncate">Jasa Pasang CCTV Murah Palembang — Tanpa DP, Garansi 1 Tahun Ganti Baru, SOP Rapi Pipa PVC!</span>
    </div>
    <div class="hidden md:flex items-center gap-4 text-slate-300 text-xs shrink-0">
      <span class="flex items-center gap-1"><MaterialIcon name="location_on" size={14} className="text-brand-400" /> Seberang Ulu &amp; Ilir Barat</span>
      <span class="flex items-center gap-1"><MaterialIcon name="schedule" size={14} className="text-brand-400" /> 07.00 - 21.00 WIB</span>
    </div>
  </div>
</div>

<!-- Main Header -->
<header class="sticky top-0 z-40 bg-slate-900/95 backdrop-blur border-b border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 shrink-0">
      <img
        src="/favicon.png"
        alt="Logo CCTV Palembang"
        width={40}
        height={40}
        class="w-10 h-10 rounded-xl object-contain shadow-lg shadow-brand-500/20"
        loading="eager"
        decoding="async"
      />
      <div class="flex flex-col -space-y-0.5 leading-none">
        <span class="text-base sm:text-lg font-black tracking-tight text-white block">CCTV PALEMBANG</span>
        <span class="text-[10px] sm:text-[11px] text-brand-400 font-semibold tracking-wide">cctvpalembang.web.id</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-1 xl:gap-2 text-sm font-medium">
      {navLinks.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`px-3 py-1.5 rounded-lg transition-colors ${
              isActive 
                ? 'bg-brand-500/15 text-brand-300 font-semibold' 
                : 'text-slate-300 hover:text-white hover:bg-slate-800'
            }`}
          >
            {item.label}
          </a>
        );
      })}

      <!-- Dropdown Layanan -->
      <div class="relative group">
        <button
          type="button"
          class={`px-3 py-1.5 rounded-lg transition-colors inline-flex items-center gap-1 ${
            isServiceActive && currentPath !== '/layanan/jasa-servis-maintenance-cctv-palembang/'
              ? 'bg-brand-500/15 text-brand-300 font-semibold'
              : 'text-slate-300 hover:text-white hover:bg-slate-800'
          }`}
          aria-haspopup="true"
          aria-expanded="false"
        >
          <span>Layanan</span>
          <MaterialIcon name="expand_more" size={16} className="transition-transform group-hover:rotate-180" />
        </button>

        <!-- Dropdown Menu -->
        <div class="absolute left-0 top-full pt-2 w-72 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 pointer-events-none group-hover:pointer-events-auto">
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-2 shadow-2xl backdrop-blur-xl">
            {serviceDropdown.map((svc) => {
              const isItemActive = currentPath === svc.href;
              return (
                <a
                  href={svc.href}
                  class={`flex items-start gap-3 p-2.5 rounded-xl transition-colors ${
                    isItemActive
                      ? 'bg-brand-500/15 text-brand-300'
                      : 'hover:bg-slate-800/80 text-slate-300 hover:text-white'
                  }`}
                >
                  <div class="w-8 h-8 rounded-lg bg-slate-800 border border-slate-700/60 flex items-center justify-center text-brand-400 shrink-0 mt-0.5">
                    <MaterialIcon name={svc.icon} size={18} />
                  </div>
                  <div>
                    <span class="block text-xs font-bold leading-tight">{svc.label}</span>
                    <span class="block text-[11px] text-slate-400 leading-snug mt-0.5">{svc.desc}</span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </div>

      <!-- Sisa Navigasi: Service CCTV, Blog, Tentang Kami -->
      {navLinksAfter.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`px-3 py-1.5 rounded-lg transition-colors ${
              isActive 
                ? 'bg-brand-500/15 text-brand-300 font-semibold' 
                : 'text-slate-300 hover:text-white hover:bg-slate-800'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <a
        href={waLink}
        target="_blank"
        rel="noopener nofollow"
        class="inline-flex items-center gap-2 px-3 sm:px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs sm:text-sm rounded-xl transition-all shadow-md shadow-emerald-900/30"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span class="hidden sm:inline">0851-0171-8690</span>
        <span class="sm:hidden">WA</span>
      </a>

      <!-- Tombol Menu Mobile -->
      <button
        type="button"
        id="mobile-menu-button"
        class="lg:hidden w-9 h-9 flex items-center justify-center rounded-lg bg-slate-800 border border-slate-700 text-slate-300 hover:text-white hover:bg-slate-700 transition-colors"
        aria-label="Buka menu navigasi"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <MaterialIcon name="menu" size={20} />
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Panel -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-800 bg-slate-900/98 backdrop-blur">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-4 space-y-1 text-sm">
      {navLinks.map((item) => (
        <a
          href={item.href}
          class={`block px-3 py-2.5 rounded-lg transition-colors ${
            currentPath === item.href
              ? 'bg-brand-500/15 text-brand-300 font-semibold'
              : 'text-slate-300 hover:text-white hover:bg-slate-800'
          }`}
        >
          {item.label}
        </a>
      ))}

      <div class="pt-2">
        <p class="px-3 pb-2 text-[11px] font-bold text-slate-500 uppercase tracking-wider">Layanan Kami</p>
        {serviceDropdown.map((svc) => (
          <a
            href={svc.href}
            class="flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 transition-colors"
          >
            <MaterialIcon name={svc.icon} size={16} className="text-brand-400 shrink-0" />
            <span class="text-xs font-medium">{svc.label}</span>
          </a>
        ))}
      </div>

      <div class="pt-2 border-t border-slate-800 mt-2">
        {navLinksAfter.map((item) => (
          <a
            href={item.href}
            class={`block px-3 py-2.5 rounded-lg transition-colors ${
              currentPath === item.href
                ? 'bg-brand-500/15 text-brand-300 font-semibold'
                : 'text-slate-300 hover:text-white hover:bg-slate-800'
            }`}
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');

    if (btn && menu) {
      btn.onclick = () => {
        const isOpen = !menu.classList.contains('hidden');
        menu.classList.toggle('hidden');
        btn.setAttribute('aria-expanded', String(!isOpen));
        btn.innerHTML = isOpen
          ? '<span class="material-symbols-outlined select-none inline-block font-fill" style="font-size:20px;line-height:1;" aria-hidden="true">menu</span>'
          : '<span class="material-symbols-outlined select-none inline-block font-fill" style="font-size:20px;line-height:1;" aria-hidden="true">close</span>';
      };
    }
  }

  document.addEventListener('astro:page-load', setupMobileMenu);
  setupMobileMenu();
</script>

<!-- Header Actions (legacy marker removed) -->
