---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const totalPosts = posts.length;
const totalServices = 5;
const today = new Date().toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' });

const siteURL = Astro.site ? Astro.site.origin : 'https://cctvpalembang.web.id';
---

<BaseLayout
  title="Peta Situs — CCTV Palembang"
  description="Daftar lengkap halaman layanan, paket, dan artikel blog CCTV Palembang."
>
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-3xl font-bold text-white mb-2">Peta Situs (Sitemap)</h1>
    <p class="text-slate-400 text-sm mb-8">Pembaruan terakhir: {today} • {totalServices} halaman layanan • {totalPosts} artikel edukasi</p>

    <div class="space-y-8">
      <div>
        <h2 class="text-lg font-bold text-brand-300 mb-3 pb-2 border-b border-slate-800">Halaman Utama</h2>
        <ul class="space-y-2 text-sm text-slate-300">
          <li><a href="/" class="hover:text-brand-300">Beranda — Jasa Pasang CCTV Palembang</a></li>
          <li><a href="/paket/" class="hover:text-brand-300">Daftar Paket &amp; Harga CCTV</a></li>
          <li><a href="/paket/paket-hemat-rumah-2-kamera/" class="hover:text-brand-300">Paket Hemat Rumah 2 Kamera — Rp 1.850.000 Tanpa DP</a></li>
          <li><a href="/paket/paket-standar-bisnis-4-kamera/" class="hover:text-brand-300">Paket Standar Bisnis 4 Kamera — Rp 2.850.000 (Paling Laris)</a></li>
          <li><a href="/area/" class="hover:text-brand-300">Area Layanan Teknisi</a></li>
          <li><a href="/tentang-kami/" class="hover:text-brand-300">Tentang Kami — Profil &amp; Workshop</a></li>
        </ul>
      </div>

      <div>
        <h2 class="text-lg font-bold text-brand-300 mb-3 pb-2 border-b border-slate-800">Halaman Layanan (Money Pages)</h2>
        <ul class="space-y-2 text-sm text-slate-300">
          <li><a href="/layanan/pasang-cctv-rumah-palembang/" class="hover:text-brand-300">Pasang CCTV Rumah Palembang</a></li>
          <li><a href="/layanan/pasang-cctv-ruko-toko-palembang/" class="hover:text-brand-300">Pasang CCTV Ruko &amp; Toko Palembang</a></li>
          <li><a href="/layanan/instalasi-ip-camera-gedung-pabrik-palembang/" class="hover:text-brand-300">Instalasi IP Camera Gedung &amp; Pabrik Palembang</a></li>
          <li><a href="/layanan/jasa-servis-maintenance-cctv-palembang/" class="hover:text-brand-300">Jasa Servis &amp; Maintenance CCTV Palembang</a></li>
          <li><a href="/layanan/paket-cctv-palembang-murah/" class="hover:text-brand-300">Paket CCTV Palembang Murah</a></li>
        </ul>
      </div>

      <div>
        <h2 class="text-lg font-bold text-brand-300 mb-3 pb-2 border-b border-slate-800">Artikel Edukasi &amp; Blog</h2>
        {posts.length === 0 ? (
          <p class="text-sm text-slate-400">Belum ada artikel yang terbit.</p>
        ) : (
          <ul class="space-y-2 text-sm text-slate-300">
            {posts.map((post) => (
              <li><a href={`/blog/${post.id}/`} class="hover:text-brand-300">{post.data.title}</a></li>
            ))}
          </ul>
        )}
        <p class="mt-3 text-xs text-slate-400">Lihat semua di <a href="/blog/" class="text-brand-400 hover:underline">/blog/</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
